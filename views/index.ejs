<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Junior Dev Portfolio</title>
    <!-- External CSS for styling -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-background text-foreground">

    <!-- Navigation Bar -->
    <nav id="navbar" class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <div class="logo-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                </div>
                <span>DEV.PORTFOLIO</span>
            </div>

            <!-- Desktop Links -->
            <div class="nav-links desktop-nav">
                <a href="#about" class="nav-link">About</a>
                <a href="#projects" class="nav-link">Projects</a>
                <a href="#contact" class="nav-link">Contact</a>
                <button class="btn btn-sm btn-primary rounded-full">Resume</button>
            </div>

            <!-- Mobile Menu Toggle -->
            <button id="mobile-menu-toggle" class="mobile-toggle">
                <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="mobile-menu hidden">
            <div class="mobile-nav-links">
                <a href="#about" class="mobile-nav-link">About</a>
                <a href="#projects" class="mobile-nav-link">Projects</a>
                <a href="#contact" class="mobile-nav-link">Contact</a>
                <button class="btn btn-primary w-full">Resume</button>
            </div>
        </div>
    </nav>

    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-bg-1"></div>
            <div class="hero-bg-2"></div>
            
            <div class="container hero-container">
                <div class="hero-content">
                    <div class="badge badge-outline animate-fade-in">Available for hire</div>
                    <h1 class="hero-title animate-slide-up">
                        BUILDING <span class="text-muted">DIGITAL</span> EXPERIENCES THAT <span class="italic font-light">MATTER.</span>
                    </h1>
                    <p class="hero-description animate-slide-up delay-1">
                        I'm a junior full-stack developer passionate about creating clean, 
                        performant, and accessible web applications. Currently focused on 
                        mastering modern backend architectures.
                    </p>
                    <div class="hero-actions animate-slide-up delay-2">
                        <button class="btn btn-lg btn-primary rounded-full group">
                            <a href="#projects" class="btn-link">View Work</a>
                            <svg class="icon-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                        <div class="social-links">
                            <a href="https://github.com/Jaeger974" class="social-link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg></a>
                            <a href="https://www.linkedin.com/in/james-mateer-bsc-46a6bb133" class="social-link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg></a>
                            <a href="https://x.com/PertinentPanda" class="social-link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="scroll-indicator">
                <span class="scroll-text">Scroll</span>
                <div class="scroll-line"></div>
            </div>
        </section>

        <!-- About Section -->
        <section id="about" class="about reveal">
            <div class="container about-container">
                <div class="about-grid">
                    <div class="about-image-wrapper">
                        <img src="/static_images/headshot_JM.jpeg" alt="Developer Profile" class="about-image" referrerPolicy="no-referrer">
                        <div class="about-image-border"></div>
                    </div>

                    <div class="about-content">
                        <div class="section-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            <span>About Me</span>
                        </div>
                        <h2 class="section-title">Passionate about solving complex problems with simple solutions.</h2>
                        <p class="section-description">
                            My journey into development started with a simple Udemy course on full stack web development. 
                            What began as a curiosity about how things work on the internet evolved into a 
                            deep dive into modern JavaScript frameworks and backend systems.
                            I am always learning and embracing the challenge of turning 
                            complex problems into elegant, user-friendly solutions.
                        </p>
                        <p class="section-description">
                            I believe in continuous learning and staying updated with the 
                            latest industry trends. When I'm not coding, you can find me 
                            exploring open-source projects or hiking with my wife and dog.
                        </p>

                        <div class="skills-area">
                            <h3 class="skills-title">Technical Arsenal</h3>
                            <div class="skills-grid">
                                <% skills.forEach(function(skill) { %>
                                    <span class="skill-badge"><%= skill %></span>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="projects" class="projects reveal">
            <div class="container">
                <div class="projects-header">
                    <div>
                        <div class="section-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                            <span>Showcase</span>
                        </div>
                        <h2 class="section-title-large">Selected Projects</h2>
                    </div>
                    <p class="header-description">
                        A collection of projects that demonstrate my technical skills and 
                        real-world solutions.
                    </p>
                </div>

                <div class="projects-grid">
                    <% projects.forEach(function(project) { %>
                        <div class="project-card">
                            <div class="project-image-wrapper">
                                <img src="<%= project.image %>" alt="<%= project.title %>" class="project-image" referrerPolicy="no-referrer">
                                <div class="project-overlay">
                                    <a href="<%= project.githubUrl %>" target="_blank" class="overlay-btn"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg></a>
                                    <a href="<%= project.liveUrl %>" target="_blank" class="overlay-btn"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></a>
                                </div>
                            </div>
                            <div class="project-info">
                                <div class="project-tags">
                                    <% project.tags.forEach(function(tag) { %>
                                        <span class="project-tag"><%= tag %></span>
                                    <% }); %>
                                </div>
                                <h3 class="project-title"><%= project.title %></h3>
                                <p class="project-description"><%= project.description %></p>
                                <a href="<%= project.liveUrl %>" class="project-link">
                                    View Project <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contact" class="contact reveal">
            <div class="contact-glow"></div>
            <div class="container">
                <div class="contact-grid">
                    <div class="contact-info">
                        <div class="section-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            <span>Get in touch</span>
                        </div>
                        <h2 class="section-title-large">Let's build something amazing together.</h2>
                        <p class="section-description">
                            Whether you have a question, a project idea, or just want to 
                            say hi, my inbox is always open. I'll do my best to get back 
                            to you as soon as possible!
                        </p>

                        <div class="contact-details">
                            <div class="contact-item">
                                <div class="contact-icon-box">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                                </div>
                                <div>
                                    <p class="contact-label">Location</p>
                                    <p class="contact-value">London, United Kingdom</p>
                                </div>
                            </div>
                            <div class="contact-item">
                                <div class="contact-icon-box">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="15" x2="23" y2="15"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="15" x2="4" y2="15"></line></svg>
                                </div>
                                <div>
                                    <p class="contact-label">Current Focus</p>
                                    <p class="contact-value">Full-stack Engineering</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="contact-form-wrapper">
                        <div class="card contact-card">
                            <div class="card-header">
                                <h3 class="card-title">Send a Message</h3>
                                <p class="card-description">Fill out the form below and I'll get back to you.</p>
                            </div>
                            <div class="card-content">
                                <form id="contact-form" class="form">
                                    <div style="display:none;">
                                        <label>Leave this field empty</label>
                                        <input type="text" name="website" tabindex="-1" autocomplete="off">
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label class="form-label">Name</label>
                                            <input type="text" name="name" placeholder="John Doe" required class="form-input">
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Email</label>
                                            <input type="email" name="email" placeholder="john@example.com" required class="form-input">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Message</label>
                                        <textarea name="message" placeholder="Tell me about your project..." required rows="5" class="form-textarea"></textarea>
                                    </div>
                                    <button type="submit" id="submit-btn" class="btn btn-primary w-full btn-submit">
                                        <span id="btn-text">Send Message</span>
                                        <svg id="btn-icon" class="icon-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                                    </button>
                                </form>
                                <div id="form-success" class="hidden success-message">
                                    Message Sent!
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer-container">
            <div class="logo">
                <div class="logo-icon-small">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                </div>
                <span>DEV.PORTFOLIO</span>
            </div>
            
            <div class="footer-links">
                <a href="#about" class="footer-link">About</a>
                <a href="#projects" class="footer-link">Projects</a>
                <a href="#contact" class="footer-link">Contact</a>
            </div>

            <p class="copyright">
                © <%= year %> Junior Developer. Built with EJS, CSS & Vanilla JS.
            </p>
        </div>
    </footer>

    <!-- Client-side JavaScript -->
    <script src="/js/main.js"></script>


</body>
</html>
